# .env.example  –  Copy to .env and fill in values before running.
# Never commit the real .env to git.

# Required: a long random hex string.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key

# Path to the SQLite database file (relative to the project root).
DATABASE=inventory.db

# Set to 1 ONLY during local development. Never in production.
FLASK_DEBUG=0
